#define FADER_PIN 4

void setup() {
  Serial.begin(115200);

  pinMode(FADER_PIN, INPUT);
  analogReadResolution(12);

  delay(1000);
  Serial.println("Fader Test Ready!");
}

void loop() {
  int value = analogRead(FADER_PIN);

  Serial.print("Fader Value: ");
  Serial.println(value);

  delay(200);
}
