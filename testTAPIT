#include <Wire.h>
#include <Adafruit_MPR121.h>

Adafruit_MPR121 cap;

#define SDA_PIN 8
#define SCL_PIN 9

uint16_t previousTouches = 0;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(SDA_PIN, SCL_PIN);

  Serial.println("Testing MPR121...");

  if (!cap.begin(0x5A)) {
    Serial.println("MPR121 NOT FOUND!");
    Serial.println("Check wiring and I2C address.");
    while (true) delay(1000);
  }

  Serial.println("MPR121 CONNECTED!");
  Serial.println("Touch electrodes 0, 1, or 2");
}

void loop() {
  uint16_t currentTouches =
      cap.touched() & 0x0007;

  for (int i = 0; i < 3; i++) {
    bool now = currentTouches & (1 << i);
    bool before = previousTouches & (1 << i);

    if (now && !before) {
      Serial.print("TAP IT! Pad ");
      Serial.print(i);
      Serial.println(" touched!");
    }

    if (!now && before) {
      Serial.print("Pad ");
      Serial.print(i);
      Serial.println(" released");
    }
  }

  previousTouches = currentTouches;

  delay(20);
}
