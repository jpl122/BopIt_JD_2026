
#include <Wire.h>
#include <Adafruit_MPR121.h>

Adafruit_MPR121 cap = Adafruit_MPR121();

const int SDA_PIN = 8;
const int SCL_PIN = 9;

uint16_t lastTouched = 0;

void setup() {
  Serial.begin(115200);
  delay(1500);

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  Serial.println("MPR121 Touch Pad Test");

  if (!cap.begin(0x5A, &Wire)) {
    Serial.println("ERROR: MPR121 NOT FOUND!");
    Serial.println("Check power, SDA and SCL.");
    while (true) {
      delay(1000);
    }
  }

  Serial.println("MPR121 CONNECTED!");
  Serial.println("Touch electrodes E0-E11.");

  lastTouched = cap.touched();
}

void loop() {
  uint16_t currentTouched = cap.touched();

  // Print new touches and releases
  for (int i = 0; i < 12; i++) {
    bool now = currentTouched & (1 << i);
    bool before = lastTouched & (1 << i);

    if (now && !before) {
      Serial.print("TOUCHED: E");
      Serial.println(i);
    }

    if (!now && before) {
      Serial.print("RELEASED: E");
      Serial.println(i);
    }
  }

  lastTouched = currentTouched;

  // Monitor baseline and filtered data
  for (int i = 0; i < 3; i++) {
    uint16_t filtered = cap.filteredData(i);
    uint16_t baseline = cap.baselineData(i);

    Serial.print("E");
    Serial.print(i);
    Serial.print(" filtered=");
    Serial.print(filtered);
    Serial.print(" baseline=");
    Serial.print(baseline);
    Serial.print(" delta=");
    Serial.print((int)baseline - (int)filtered);

    if (i < 2) Serial.print(" | ");
  }

  Serial.println();
  delay(200);
}
